# Kopiere diese Datei nach .env und trag deinen Key ein.
# Key von https://developer.riotgames.com (der Development Key läuft nach 24 Stunden ab).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Server, dessen Ranglisten und Matches geladen werden: euw1, eun1, na1, kr, ...
RIOT_PLATFORM=euw1

# Vorlage für deploy/.env auf dem Server (cp deploy/env.example deploy/.env, dann ausfüllen).
# Die echte .env nie committen.

# Riot-Key (Personal Key, später Production Key)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Server, je Routing-Region einer
RIOT_PLATFORM=euw1,na1

# GitHub: fine-grained Token, nur Repo pinkward-data, Berechtigung „Contents: Read and write“
GITHUB_TOKEN=github_pat_xxxxxxxx
GITHUB_REPO=Seimouun/pinkward-data
RELEASE_TAG=data

# Wie lange je Runde gecrawlt wird, bevor exportiert und hochgeladen wird
CRAWL_MINUTES=90
